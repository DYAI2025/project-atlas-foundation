%% C4 Level 2 — Container view, Project ATLAS
%% Declared by architecture-decision.json (AD-001) as diagram_paths[1].
%% Authoritative reasoning: architecture/adr/ADR-0001-canonical-store-and-gbrain-projection.md
%%
%% STATUS OF THIS DIAGRAM — read before citing it as evidence:
%%   Lane A is now an IMPLEMENTED LOCAL PILOT boundary: ATLAS-65 provides the
%%   real-source capture/projection/readback path and ATLAS-39/40 provide the
%%   local Semantic Atlas WebGL consumer. This remains a bounded developer-machine
%%   pilot and does NOT assert production isolation, publication controls or scale.
%%   Lane B remains TARGET STATE and is not an implementation-status claim.
%%   reports/release-decision.json may continue to report NOT_READY for production;
%%   that is compatible with Lane A being implemented and Lane B remaining open.
%%
%% The two lanes are deliberately separate and must not be read as one production pipeline:
%%   Lane A produces evidence for Lane B. It never substitutes for it, and passing
%%   Lane A never discharges a Lane B release gate.
%%
%% The current local browser consumer uses the ATLAS-39/40 WebGL workspace. Lane B
%% remains stack-neutral: no production graph UI stack is selected by this diagram.
flowchart TB

  subgraph LANE_A["Lane A — implemented local pilot (ATLAS-65 + ATLAS-39/40)"]
    direction TB
    A_SRC["Approved ATLAS source revision<br/>real content, bounded and explicitly selected"]
    A_IMPORT["Bounded project-scoped capture, import and projection<br/>single project scope, deterministic, rebuildable from source"]
    A_STORE["Local pinned GBrain persistence<br/>developer machine only, real local derived data,<br/>projection-local/v1 identifiers, discardable and rebuildable"]
    A_READ["Persisted readback + gbrain-read/v1 contract<br/>contracts/gbrain-read/v1, read-only and fail-closed"]
    A_VIEW["Local Semantic Atlas browser workspace<br/>WebGL read-side consumer with evidence inspector"]
    A_SRC --> A_IMPORT --> A_STORE --> A_READ --> A_VIEW
  end

  subgraph LANE_B["Lane B — later production target (target state, not implemented)"]
    direction TB
    subgraph B_DEPLOY["VPS deployment boundary (conditional on the ATLAS-16 audit)"]
      direction TB
      B_CORE["ATLAS-owned canonical control plane<br/>project registry, source-revision identity,<br/>proposals, approval evidence, audit, checkpoints"]
      B_ISO["Isolation and authorization controls<br/>project_id on canonical data, PostgreSQL RLS,<br/>separate service roles, separate approver and publisher identities"]
      B_PROJ["Derived GBrain projection<br/>rebuilt idempotently from approved revisions,<br/>with checkpoints, projection lag and reconciliation"]
      B_CORE --> B_ISO
      B_ISO --> B_PROJ
    end
    B_CONS["Read consumers: graph UI, MCP, search<br/>read-only, stack-neutral at this level"]
    B_PROJ --> B_CONS
  end

  A_VIEW -.->|"pilot evidence informs the target, never authorizes it"| B_CORE
